{
  "name": "khiemflayer",
  "version": "1.1.17",
  "description": "create minecraft bots with a stable, high level API",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "mocha_test": "mocha --reporter spec --exit",
    "test": "npm run mocha_test",
    "pretest": "npm run lint",
    "lint": "standard && standard-markdown",
    "fix": "standard --fix && standard-markdown --fix",
    "prepublishOnly": "node -e \"require('fs').copyFileSync('docs/README.md', 'README.md')\""
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/VGKhiem/khiemflayer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "khiemflayer-minecraft-data": "^3.111.0",
    "khiemflayer-minecraft-protocol": "^1.66.6",
    "mojangson": "^2.0.4",
    "khiemflayer-minecraft-biome": "^1.1.1",
    "khiemflayer-minecraft-block": "^1.22.0",
    "khiemflayer-minecraft-chat": "^1.7.1",
    "khiemflayer-minecraft-chunk": "^1.40.0",
    "khiemflayer-minecraft-entity": "^2.5.0",
    "khiemflayer-minecraft-item": "^1.17.0",
    "khiemflayer-minecraft-nbt": "^2.0.0",
    "khiemflayer-minecraft-physics": "^1.11.0",
