    "khiemflayer-minecraft-windows": "^2.9.0",
    "khiemflayer-minecraft-world": "^3.6.0",
    "protodef": "^1.19.0",
    "typed-emitter": "^1.0.0",
    "uuid-1345": "^1.0.2",
    "vec3": "^0.1.7"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "doctoc": "^2.0.1",
    "minecraft-wrap": "^1.3.0",
    "mocha": "^11.0.1",
    "protodef-yaml": "^1.5.3",
    "standard": "^17.0.0",
    "standard-markdown": "^7.1.0",
    "typescript": "^5.4.5"
  }
